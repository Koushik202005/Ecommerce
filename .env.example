# Local PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/white_label_store

# Use a unique random value of at least 32 characters outside local development.
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

DEFAULT_STORE_SLUG=blockhaus
PLATFORM_HOST=localhost
PG_POOL_MAX=5
